{
  "manifest_version": 3,
  "name": "Monitor for MyEpisodes",
  "version": "3.2.0",
  "description": "Your MyEpisodes schedule at a glance. Unofficial; not affiliated with or endorsed by MyEpisodes.",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://api.tvmaze.com/*",
    "https://api.myepisodes.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Monitor for MyEpisodes",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
